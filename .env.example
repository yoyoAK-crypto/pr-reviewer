# Copy this file to .env and fill in your own values. Never commit .env.

# Required: model calls (https://console.groq.com/keys)
GROQ_API_KEY=

# Required: read PRs and post reviews.
# Fine-grained token with Contents: Read-only and Pull requests: Read and write.
GITHUB_TOKEN=

# Required for the webhook server. Use a long random string, and put the same value in GitHub's webhook settings.
GITHUB_WEBHOOK_SECRET=

# Optional: Groq tokens-per-minute limit used by evals/run_evals.py (default 8000)
# GROQ_TPM=8000

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pr-reviewer

# Optional: which search feeds related code to the reviewers: off | keyword | hybrid | rerank
# keyword measured best on the cross-file evals. hybrid/rerank need requirements-rag.txt.
RETRIEVAL_MODE=keyword

# Optional: prompt-injection defenses (on by default; "off" only for evals)
# INJECTION_DEFENSE=on

# Optional: smee.io channel URL, used by "docker compose --profile tunnel up"
# SMEE_URL=https://smee.io/your-channel
